# Karasu server settings. Copy to .env and fill in. Never commit .env.
# Generated from web/app/apis.json by `npm run apis`.

PORT=3010

# ---- Free key needed
# aisstream.io: Live ship positions, identity, speed, course, draught, destination
AISSTREAM_API_KEY=
# USDA NASS Quick Stats: Cattle, hogs, poultry, dairy and crops by state
NASS_API_KEY=
# FRED (St. Louis Fed): Rates, inflation, jobs and thousands of US and state series
FRED_API_KEY=
# US Energy Information Administration: Oil and gas inventories, refinery runs, output and prices by state
EIA_API_KEY=
# Bureau of Economic Analysis: GDP and personal income by state and industry
BEA_API_KEY=
# Bureau of Labor Statistics: Jobs, unemployment and wages by state and metro
BLS_API_KEY=
# US Census Bureau: Population, income, building permits, and trade by port and product
CENSUS_API_KEY=
# UN Comtrade: Imports and exports by product between any two countries
COMTRADE_API_KEY=
# OpenFIGI: Matches a ticker on any exchange to one company identity
OPENFIGI_API_KEY=
# NASA FIRMS: Satellite wildfire detections worldwide
FIRMS_MAP_KEY=
# openFDA: Drug and device approvals and recalls by company
OPENFDA_API_KEY=
# USPTO PatentsView: Patents filed and granted by company
PATENTSVIEW_API_KEY=
# USDA Foreign Agricultural Service: Weekly export sales and world crop and meat supply
FAS_API_KEY=
# SAM.gov: Federal contract opportunities before they are awarded
SAM_API_KEY=
# Stripe: Takes payment and tells the server when someone subscribes or cancels
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- No key needed
# SEC EDGAR: Every US-listed company with its state, filings, insider trades, fund holdings
SEC_USER_AGENT=
# Amazon SES: Password reset emails and copies of contact form messages
MAIL_FROM=
# Admin token: Lets the owner switch an account between free and paid from the server
ADMIN_TOKEN=

# ---- Decision needed
# OpenSky Network: Live aircraft positions, for cargo flights
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Delayed market prices: Stock and futures prices, delayed or end of day
PRICES_API_KEY=
# Ship registry details: Each ship's design draught, deadweight and owner
VESSEL_API_KEY=
# Exchange listings outside the US: Complete company lists for London, Tokyo, Hong Kong and other exchanges
LISTINGS_API_KEY=
# Paid plan prices and checkout links: The prices shown on the site and where the upgrade buttons send people
PRICE_MONTHLY=
PRICE_YEARLY=
CHECKOUT_LINK_MONTHLY=
CHECKOUT_LINK_YEARLY=
